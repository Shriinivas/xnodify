import sys
from pathlib import Path
_common_path = str(Path(__file__).resolve().parent.parent / "common")
if _common_path not in sys.path:
    sys.path.insert(0, _common_path)
from xfy_utils import delete_obj, create_obj, create_mat, create_gp_mat

twopi = 6.283185307179586
footMult = 3.28084
inchMult = 39.37008
arcColor      = (0.4, 1.0, 0.7, 1.0)  # Mint Green
arrowColor    = (0.4, 1.0, 0.7, 1.0)   # Mint Green
mainLineColor = (0.8, 0.8, 0.8, 1.0)  # Light Silver
refLineColor  = (0.8, 0.8, 0.8, 0.2)   # Ghostly Silver
connLineColor  = (0.8, 0.8, 0.8, 0.2)   # Ghostly Silver
textColor     = (0.4, 1.0, 0.7, 1.0)   # Matches Arrow (Mint Green)
dotColor      = (0.4, 0.7, 1.0, 1.0)   # Sky Blue
connLineColor = (0.6, 0.6, 0.6, 0.5)   # Light Gray for GP

def clear_objects():
  for o in list(bpy.data.objects):
    if o.name != 'DummyObject' and o.type not in {'CAMERA', 'LIGHT'} and not o.name.startswith('_'):
      try:
        delete_obj(o)
      except Exception:
        pass

def do_measure_setup(obj, outType='both'):
  import bpy

  if outType != 'mesh':
    m1 = create_gp_mat("GP_TextFill", fill=textColor, show_stroke=False)
    m2 = create_gp_mat("GP_ArrowFill", fill=arcColor, show_stroke=False)
    m3 = create_gp_mat("GP_DotFill", fill=dotColor, show_stroke=False)
    if obj and hasattr(obj, "data") and hasattr(obj.data, "materials"):
      if m1.name not in obj.data.materials: obj.data.materials.append(m1)
      if m2.name not in obj.data.materials: obj.data.materials.append(m2)
      if m3.name not in obj.data.materials: obj.data.materials.append(m3)
  if outType != 'gp':
    create_mat(obj, 'Main Line Material', color_val=arcColor, emission_strength=1)
    create_mat(obj, 'Ref Line Material', color_val=refLineColor, emission_strength=1)
    create_mat(obj, 'Conn Line Material', color_val=connLineColor, emission_strength=1)
    create_mat(obj, 'Text Material', color_val=textColor, emission_strength=1)
    create_mat(obj, 'Dot Material', color_val=dotColor, emission_strength=1)

  light = bpy.data.objects.get('Light')
  if light:
    light.location = (2.10, -1.02, 3.23)

