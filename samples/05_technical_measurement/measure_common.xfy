# Helper: Create GP marker dot at position
group fn_gp_marker "GP Marker Dot" {
  input pos: vector "Position"
  input radius: float "Radius" = 0.01
  input baseRot: vector "Base Rotation"
  input mat: mat "Material"
  output result: geometry "GP Marker"

  dot = curve_primitive_circle(32, radius)
  dot = transform(dot, , , baseRot)
  dot = set_position(dot, , , pos)
  # Store attribute required for 5.1 and set_grease_pencil_depth required for 5
  dot = store_named_attribute{data_type:'BOOLEAN'}(dot, , 'hide_stroke', True)
  dot = store_named_attribute{data_type:'INT'}(dot, , 'fill_id', 1)
  result = geometry_to_instance(set_material(set_grease_pencil_depth(curves_to_grease_pencil(geometry_to_instance(dot))), , mat))
}

# Helper: Create mesh sphere marker at position  
group fn_mesh_marker "Mesh Marker Sphere" {
  input pos: vector "Position"
  input radius: float "Radius" = 0.01
  output result: geometry "Mesh Marker"

  result = transform(uvsphere(32, 16, radius), , pos)
}

# Helper: Create GP triangle arrowhead
# Used for arc arrowheads in GP mode
group fn_gp_arrowhead "GP Arrowhead Triangle" {
  input pos: vector "Position"
  input dir: vector "Direction"
  input baseRot: vector "Base Rotation"
  input headRad: float "Head Radius"
  input headLen: float "Head Length"
  output result: geometry "GP Arrowhead"

  # Create triangle shape (circle with 3 vertices)
  headCircleRadius = headLen * 0.6667
  triShape = curve_primitive_circle(3, headCircleRadius)
  triShape = set_position(triShape, , , combine_xyz(-0.667 * headLen, 0, 0))
  headScale = combine_xyz(1, headRad / headCircleRadius, 1)
  
  # Rotate to align with direction
  headRot = align_rotation_to_vector{axis:'X', pivot_axis:'Z'}(baseRot, , dir)
  result = transform(triShape, , pos, headRot, headScale)
}

# Helper: Create mesh cone arrowhead
group fn_mesh_arrowhead "Mesh Arrowhead Cone" {
  input pos: vector "Position"
  input dir: vector "Direction"
  input headRadTop: float "Top Head Radius"
  input headRadBottom: float "Bottom Head Radius"
  input headLen: float "Head Length"
  output result: geometry "Mesh Arrowhead"

  rot = align_rotation_to_vector{axis:'Z'}(, , dir)
  cone = set_shade_smooth(mesh_cone(, , , headRadTop, headRadBottom, headLen), face_neighbors() < 4)
  result = transform(cone, , pos, rot)
}

# Helper: Create extruded text mesh
group fn_text_mesh "Extruded Text Mesh" {
  input textCurves: geometry "Text Curves"
  input pos: vector "Position"
  input rot: vector "Rotation"
  input thickness: float "Thickness" = 0.001
  input flipText: bool "Flip Text" = False
  input mat: mat "Material"
  output result: geometry "Text Mesh"

  filled = fill_curve(textCurves)
  extruded = extrude_mesh(filled, , combine_xyz(0, 0, thickness))
  combined = join_geometry(filled ~ extruded)
  flipScale = switch{input_type:'VECTOR'}(flipText, (-1, 1, 1), (1, 1, 1))
  result = set_material(transform(combined, , pos, rot, flipScale), , mat)
}

# Helper: Generate text curves with subtext substitution and width calculation
# Used by both fn_angle_calc and fn_distance_calc
group fn_make_text_curves "Make Text Curves" {
  input calculatedStr: string "Calculated String" @ "The computed measurement string"
  input subtext: string "Substitute Text" @ "Override text (if non-empty)"
  input textSize: float "Text Size" = 0.05
  input flipText: bool "Flip Text" = False
  output textCurves: geometry "Text Curves"
  output textWidth: float "Text Width"
  output displayStr: string "Display String"

  # Apply subtext substitution if provided
  subtextLen = string_length(subtext)
  displayStr = switch{input_type:'STRING'}(subtextLen > 0, calculatedStr, subtext)

  # Generate text curves
  textCurves = get_text_curves(displayStr, textSize) #string_to_curves{align_x:'CENTER', align_y:'MIDDLE'}(displayStr, textSize)
  
  # Apply flip if needed
  flippedText = transform(textCurves, , , , combine_xyz(-1, 1, 1))
  textCurves = switch{input_type:'GEOMETRY'}(flipText, textCurves, flippedText)
  
  # Calculate text width from bounding box
  (_, _, _, _, _, bbSize) = attribute_statistic{data_type:'FLOAT_VECTOR', domain:'POINT'}(realize_instances(textCurves), , position())
  textWidth = separate_xyz(bbSize)[0]
}
