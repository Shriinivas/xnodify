# ==============================================================================
# Multi-Tree Scene: Geometry Nodes, Material Shaders & World Environment
# Demonstrates unified multi-context XFY execution in a single script:
# 1. Preprocessing Python setup ensuring target object exists
# 2. Geometry Nodes modifier building procedural mesh geometry
# 3. Object Material shader graph with procedural noise & color ramp
# 4. World Environment shader defining studio background lighting
# ==============================================================================

```
import bpy

# Ensure the target object exists in the scene
if not __parents__:
    obj_name = "Pedestal"
    if obj_name not in bpy.data.objects:
        mesh_data = bpy.data.meshes.new(obj_name)
        obj = bpy.data.objects.new(obj_name, mesh_data)
        bpy.context.scene.collection.objects.link(obj)
        bpy.context.view_layer.objects.active = obj
```

# 1. Geometry Modifier for the Object
object "Pedestal" as "PedestalGeo" {
    output mesh: geometry "Geometry"

    base_disc = mesh_cylinder(vertices=64, radius=1.8, depth=0.25)
    upper_disc = mesh_cylinder(vertices=64, radius=1.4, depth=0.25)
    upper_disc = transform_geometry(upper_disc, translation=combine_xyz(0.0, 0.0, 0.25))

    orb = icosphere(radius=0.7, subdivisions=3)
    orb = transform_geometry(orb, translation=combine_xyz(0.0, 0.0, 1.1))

    mesh = set_shade_smooth(join_geometry(base_disc ~ upper_disc ~ orb))
}

# 2. Procedural Material Surface Shader for the Object
object "Pedestal" material as "PedestalMarble" {
    # Generate marble veining with noise texture
    pos = tex_coord()[0] # Generated coords
    noise_val = tex_noise(pos, scale=3.5, detail=8.0, roughness=0.6)[0]

    # Map noise to soft white & slate blue marble tones
    marble_col = color_ramp{
        remove:'0',
        add:'0.1:(0.12, 0.15, 0.22, 1.0)',
        add:'0.65:(0.85, 0.88, 0.92, 1.0)'
    }(noise_val)

    # Polished reflective surface
    bsdf = bsdf_principled(base_color=marble_col, roughness=0.15, metallic=0.05)
    output_material(surface=bsdf)
}

# 3. World Environment Shader
world "MinimalistStudio" {
    # Deep slate studio background
    bg = bsdf_background(color=(0.03, 0.03, 0.05, 1.0), strength=1.2)
    output_world(surface=bg)
}
